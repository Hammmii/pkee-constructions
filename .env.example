# --- Database ---
# Local dev: project-local Postgres (npm run db:start) or a hosted URL (Neon/Vercel/Supabase).
# Never commit credentials — keep them in your untracked .env only.
DATABASE_URL=postgres://127.0.0.1:5432/pkee
PGPASSWORD=set-a-local-dev-password

# --- Site ---
# Canonical URL used for absolute links/OG tags (metadata) and sitemap locs.
# Falls back to https://www.pkeeconstructions.ca when unset — set it per
# environment (e.g. http://localhost:3000 in local .env for dev).
NEXT_PUBLIC_SITE_URL=https://www.pkeeconstructions.ca
# Analytics provider ID. Optional — when unset the tracker is a no-op and
# no analytics script renders on any page.
NEXT_PUBLIC_ANALYTICS_ID=

# --- Payload ---
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email ---
# REMOVED: the Resend pipeline (RESEND_API_KEY, LEADS_NOTIFICATION_EMAIL) was
# replaced by a WhatsApp handoff — every intake form's confirmation page
# deep-links into a chat with the business number in lib/site.ts. Leads are
# stored in Payload; no transactional email is sent.
PUBLIC_CONTACT_EMAIL=info@pkeeconstructions.ca

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Media storage (Supabase Storage via the S3-compatible API) ---
# Wired into payload.config.ts via @payloadcms/storage-s3 for the `media`
# collection. If S3_BUCKET is unset, Payload logs a boot warning and media
# stays on the local disk (local dev / CI).
#
# Supabase setup:
#   1. Supabase Dashboard → Storage → New bucket (private or public — the
#      adapter signs/serves via the API either way).
#   2. Project Settings → Storage → S3 Access Keys → create a key pair.
#   3. S3_ENDPOINT = https://<project-ref>.supabase.co/storage/v1/s3
#      S3_REGION  = the project's region (e.g. ca-central-1), or `auto`.
#
# Media URLs derive from S3_ENDPOINT/S3_BUCKET automatically; S3_PUBLIC_URL
# is only needed if you front the bucket with a custom CDN domain (it is also
# read by next.config.ts to allowlist the image host for next/image).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=
