# --- Database ---
# Local dev: project-local Postgres (npm run db:start) or a hosted URL (Neon/Vercel/Supabase).
# Never commit credentials — keep them in your untracked .env only.
DATABASE_URL=postgres://127.0.0.1:5432/pkee
PGPASSWORD=set-a-local-dev-password

# --- Site ---
# Canonical URL used for absolute links/OG tags (metadata). Falls back to
# http://localhost:3000 in dev when unset.
NEXT_PUBLIC_SITE_URL=https://pkeeconstructions.ca
# Analytics provider ID. Optional — when unset the tracker is a no-op and
# no analytics script renders on any page.
NEXT_PUBLIC_ANALYTICS_ID=

# --- Payload ---
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=sales@pkeeconstructions.ca
PUBLIC_CONTACT_EMAIL=info@pkeeconstructions.ca

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Media storage (reserved for the future S3 adapter) ---
# Not read by the code yet — media currently serves from local disk.
# Production checklist: wire a Payload S3 storage adapter before launch so
# Vercel's ephemeral filesystem doesn't lose uploads.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
